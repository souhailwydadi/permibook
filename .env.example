# PermiBook — copy to .env.local and fill in your own values.
# NEVER commit real keys. The service-role key is server-only:
# it must never be exposed to the browser or shipped in client code.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this deployment (used for reminder links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase service-role key — SERVER ONLY (API routes / admin actions).
# Never put this in NEXT_PUBLIC_* and never use it from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
